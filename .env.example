# Copy to .env and fill in:  cp .env.example .env
# .env is git-ignored. NEVER commit it.

# --- Login ---
# Password you type on the login page
APP_PASSWORD=change-me-to-a-long-password
# Random string used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-openssl-rand-hex-32

# --- Database ---
DB_DATABASE=life_tracker
DB_USER=planner
DB_PASSWORD=change-me-db-password

# --- Docker only: host port on 127.0.0.1 that nginx proxies to ---
APP_PORT=34823

# --- Local development without Docker (npm run dev) ---
# PORT=34823
# DB_HOST=localhost
# DB_PORT=5432
