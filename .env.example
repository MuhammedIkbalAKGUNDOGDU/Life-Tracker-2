# ============================================================
#  Softium Planner - ortam değişkenleri şablonu
#  Kullanım:   cp .env.example .env   (sonra aşağıdaki değerleri doldur)
#  .env dosyası .gitignore'dadır, ASLA GitHub'a gönderilmez.
# ============================================================

# ------------------------------------------------------------
#  1) GİRİŞ / HESAP
# ------------------------------------------------------------
# Kullanıcı adı ve şifreyi buraya YAZMIYORSUN. Uygulamayı ilk açtığında
# "Hesabı Oluştur" ekranından kendin belirliyorsun. Şifre veritabanında
# düz yazı olarak değil, hash'lenmiş saklanır. Sadece 1 hesap olabilir.
#
# SETUP_CODE = İLK KURULUM KODU.
#   - Hesabı oluştururken bir kez sorulur, sonra bir daha kullanılmaz.
#   - Amacı: sunucuyu yayına alıp hesabı oluşturana kadar geçen sürede,
#     domaini bulan başka biri hesabı senden önce açamasın.
#   - Kendin uzun/tahmin edilmesi zor bir değer yaz.
#   - BOŞ bırakırsan sunucu rastgele bir kod üretip loga yazar:
#       docker compose logs app     ("İlk kurulum kodu: XXXXXXXX")
SETUP_CODE=change-me-setup-code

# SESSION_SECRET = (isteğe bağlı) giriş cookie'lerini imzalayan gizli anahtar.
#   - BOŞ bırakırsan otomatik üretilir ve veritabanında saklanır (öneri budur).
#   - Elle vermek istersen:  openssl rand -hex 32
#   - Değiştirirsen açık tüm oturumlar kapanır.
SESSION_SECRET=

# ------------------------------------------------------------
#  2) VERİTABANI (PostgreSQL)
# ------------------------------------------------------------
# Docker kullanıyorsan veritabanı bu bilgilerle kendiliğinden oluşturulur.
DB_DATABASE=life_tracker
DB_USER=planner
DB_PASSWORD=change-me-db-password

# ------------------------------------------------------------
#  3) PORT (sadece Docker)
# ------------------------------------------------------------
# Uygulama sunucuda yalnızca 127.0.0.1:<APP_PORT> üzerinde açılır, internetten
# doğrudan erişilemez. nginx bu porta yönlendirir (deploy/nginx.conf.example).
APP_PORT=34823

# ------------------------------------------------------------
#  4) TELEGRAM BOTU (isteğe bağlı, ücretsiz)
#     - Ödeme hatırlatması (her sabah)
#     - Spor ve yemek girişi (bench 80x8, yumurta 3 adet ...)
# ------------------------------------------------------------
# Kurulum: Telegram'da @BotFather ile bot oluştur, token'ı al.
# Sonra bota bir mesaj yaz ve şu adresten chat id'ni bul:
#   https://api.telegram.org/bot<TOKEN>/getUpdates   ("chat":{"id": ...})
# Boş bırakırsan bot kapalı olur.
#
# DİKKAT: Bot aynı anda SADECE BİR yerde çalışmalı (sunucu YA DA bilgisayarın).
# Sunucuda çalıştırıyorsan bilgisayarındaki .env'de bu üç satırı boş bırak.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Ödeme hatırlatmasının geleceği saat (0-23). Saat dilimi aşağıdaki TZ'dir.
REMINDER_HOUR=9
TZ=Europe/Istanbul

# ------------------------------------------------------------
#  5) SADECE YEREL GELİŞTİRME (Docker'sız: npm run dev)
# ------------------------------------------------------------
# PORT=34823
# DB_HOST=localhost
# DB_PORT=5432
#
# AUTH_DISABLED=true  -> girişi tamamen kapatır. Sadece kendi bilgisayarında
#                        dene, sunucuda ASLA kullanma.
